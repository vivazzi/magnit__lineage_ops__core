generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  schemas           = ["public"]
}

enum LineageExportStatus {
  new
  in_progress
  completed
  failed

  @@schema("public")
}

enum LineageDirection {
  in
  out
  both

  @@schema("public")
}

enum LineageAssociation {
  column
  table

  @@schema("public")
}

model lineage_export {
  // job metadata
  id Int @id @default(autoincrement())

  // lifecicle job
  status LineageExportStatus @default(new)

  // actual "result_code" see in zod schema
  // ex: ready, empty, not_found
  result_code   String?
  attempt_count Int     @default(0)

  // actual "error_code" see in zod schema
  // ex: timeout
  error_code    String?
  error_message String?

  path String?

  created_at  DateTime  @default(now())
  started_at  DateTime?
  finished_at DateTime?
  expires_at  DateTime?

  // export payload
  user_email            String
  obj_id                String
  association           LineageAssociation
  is_reference_obj      Boolean
  direction             LineageDirection
  is_horizontal_lineage Boolean
  is_all_columns        Boolean

  @@index([status, created_at])
  @@map("lineage_export")
  @@schema("public")
}
