{
  "incremental": true,
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "composite": true,
    "tsBuildInfoFile": "./.tmp/tsconfig.app.tsbuildinfo",
    "strict": true,
    "moduleResolution": "Bundler",
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "target": "esnext",
    "module": "esnext",
    "paths": {
      "#root/*": ["./*"],

      "#scripts/*": ["./scripts/*"],

      "#app/*": ["./src/app/*"],

      "#config": ["./src/config"],

      "#infra/*": ["./src/infra/*"],
      "#db": ["./src/infra/db"],

      "#modules/*": ["./src/modules/*"],
      "#shared": ["./src/shared"],
    }
  },
  "include": ["src", "scripts"],
  "exclude": ["prisma"],
}
