{
  "incremental": true,
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "composite": true,
    "tsBuildInfoFile": "./.tmp/tsconfig.app.tsbuildinfo",
    "strict": true,
    "moduleResolution": "Bundler",
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "target": "esnext",
    "module": "esnext",
    "paths": {
      "#root/*": ["./*"],
      "#src/*": ["./src/*"],
    }
  },
  "include": ["src", "scripts"],
  "exclude": ["prisma"],
}
